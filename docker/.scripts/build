#!/usr/bin/env bash
set -euo pipefail

############################################################
######################## setup #############################
############################################################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOCKER_DIR="$(dirname "$SCRIPT_DIR")"
WORKSPACE_DIR="$(git rev-parse --show-toplevel)"

CHANGED_FOLDERS=()

############################################################
######################### check #############################
############################################################

source "$WORKSPACE_DIR/.scripts/utils/has_changes"

echo "Docker" >&2

for folder_dir in "$DOCKER_DIR"/*; do
  [ -d "$folder_dir" ] || continue

  folder="$(basename "$folder_dir")"

  if has_changes "$folder_dir"; then
    echo "  $folder: changes detected" >&2
    CHANGED_FOLDERS+=("$folder")
  else
    echo "  $folder: no changes" >&2
  fi
done

############################################################
########################## build ##############################
############################################################

for folder in "${CHANGED_FOLDERS[@]}"; do
  "$DOCKER_DIR/$folder/.scripts/build"
done
