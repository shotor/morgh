#!/usr/bin/env bash
set -euo pipefail

############################################################
######################## setup #############################
############################################################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGES_DIR="$(dirname "$SCRIPT_DIR")"
WORKSPACE_DIR="$(git rev-parse --show-toplevel)"

############################################################
######################## usage #############################
############################################################

usage() {
  cat <<EOF
Usage: $0 <image> [source]

Build and publish a Docker image.

Arguments:
  image           Image to release
  source          Optional image source directory
                  Defaults to $IMAGES_DIR/<image>

Options:
  -h, --help      Show this help message
EOF
}

############################################################
######################## parse #############################
############################################################

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
esac

IMAGE="$1"
IMAGE_DIR="${2:-"$IMAGES_DIR/$IMAGE"}"

############################################################
######################## sources ############################
############################################################

source "$WORKSPACE_DIR/.scripts/utils/log"
source "$WORKSPACE_DIR/.scripts/utils/get_version"
source "$SCRIPT_DIR/utils/build_docker"

VERSION="$(get_version "$IMAGE_DIR")"
REPOSITORY="ghcr.io/shotor/$IMAGE"

############################################################
######################## build ##############################
############################################################

info "$IMAGE: building"

build_docker \
  "$IMAGE_DIR" \
  "$REPOSITORY" \
  "$VERSION" \
  >&2

success "$IMAGE: build complete"

############################################################
######################## release ############################
############################################################

info "$IMAGE: pushing $REPOSITORY:$VERSION"

docker push "$REPOSITORY:$VERSION"

success "$IMAGE: pushed $REPOSITORY:$VERSION"

info "$IMAGE: pushing $REPOSITORY:latest"

docker push "$REPOSITORY:latest"

success "$IMAGE: pushed $REPOSITORY:latest"
