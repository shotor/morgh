#!/usr/bin/env bash
set -euo pipefail

############################################################
######################## setup #############################
############################################################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGES_DIR="$(dirname "$SCRIPT_DIR")"
WORKSPACE_DIR="$(git rev-parse --show-toplevel)"

CHANGED_IMAGES=()

############################################################
######################### check #############################
############################################################

source "$WORKSPACE_DIR/.build/utils/get_latest_package_tag"
source "$WORKSPACE_DIR/.build/utils/has_changes"

echo "Docker images" >&2

for image_dir in "$IMAGES_DIR"/*; do
  [ -d "$image_dir" ] || continue

  image="$(basename "$image_dir")"
  tag="$(get_latest_package_tag "$image_dir")"

  if [ -z "$tag" ]; then
    echo "  $image: no tag found, will release" >&2
    CHANGED_IMAGES+=("$image")

  elif has_changes "$image_dir"; then
    echo "  $image: changes since $tag, will release" >&2
    CHANGED_IMAGES+=("$image")

  else
    echo "  $image: no changes since $tag" >&2
  fi
done

############################################################
######################### setup #############################
############################################################

source "$WORKSPACE_DIR/.build/utils/bump_package"
source "$WORKSPACE_DIR/.build/utils/generate_changelog"
source "$WORKSPACE_DIR/.build/utils/get_version"
source "$WORKSPACE_DIR/.build/utils/get_package_tag"

source "$SCRIPT_DIR/utils/build_docker"

############################################################
######################## release ############################
############################################################

for image in "${CHANGED_IMAGES[@]}"; do
  image_dir="$IMAGES_DIR/$image"

  ##########################################################
  ###################### version ###########################
  ##########################################################

  from_version="$(get_version "$image_dir")"

  bump_package "$image_dir" >&2

  new_version="$(get_version "$image_dir")"
  tag="$(get_package_tag "$image_dir" "$new_version")"

  echo "  $image: $from_version -> $new_version" >&2

  ##########################################################
  ###################### changelog #########################
  ##########################################################

  generate_changelog "$image_dir" "$new_version" >&2

  ##########################################################
  ######################## build ###########################
  ##########################################################

  echo "  $image: building" >&2

  build_docker "$image" "$image_dir" "$new_version" >&2

  ##########################################################
  ######################## return ##########################
  ##########################################################

  echo "$tag"
done
