#!/usr/bin/env bash
set -euo pipefail

############################################################
######################## setup #############################
############################################################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(git rev-parse --show-toplevel)"

FOLDERS=(
  "devcontainer"
  "docker"
)

CHANGED_FOLDERS=()

############################################################
######################## validate ###########################
############################################################

COMMIT_MESSAGE="$(git log -1 --format=%B)"

if [[ "$COMMIT_MESSAGE" != bump:* ]]; then
  echo "Current commit is not a release commit" >&2
  echo "Expected commit message to start with: bump:" >&2
  exit 1
fi

############################################################
######################### check #############################
############################################################

source "$SCRIPT_DIR/utils/has_commit_changes"

echo "Checking release commit" >&2

for folder in "${FOLDERS[@]}"; do
  folder_dir="$WORKSPACE_DIR/$folder"

  if [ ! -d "$folder_dir" ]; then
    echo "$folder: not found" >&2
    continue
  fi

  if has_commit_changes "$folder_dir"; then
    echo "$folder: changes detected" >&2
    CHANGED_FOLDERS+=("$folder")
  else
    echo "$folder: no changes" >&2
  fi
done

############################################################
######################## release ############################
############################################################

for folder in "${CHANGED_FOLDERS[@]}"; do
  release="$WORKSPACE_DIR/$folder/.scripts/release"

  if [ ! -x "$release" ]; then
    echo "$folder: .scripts/release not found or not executable" >&2
    exit 1
  fi

  "$release"
done
