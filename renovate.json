{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Dockerfile FROM pins by the default managers; versions in ARGs under a renovate comment naming their source; fix commits, so a merged bump releases its package",
  "dependencyDashboard": true,
  "labels": [
    "renovate"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  },
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "docker",
  "customManagers": [
    {
      "customType": "regex",
      "description": "a version in an ARG: datasource, name and an optional extractVersion in the comment above it",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\nARG \\w+=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "a commit in an ARG, followed on its branch",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\nARG \\w+=(?<currentDigest>[0-9a-f]{40})"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "workflow updates release nothing",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "actions"
    }
  ]
}
