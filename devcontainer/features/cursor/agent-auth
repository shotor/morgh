#!/usr/bin/env bash
set -euo pipefail

AUTH_DIR="$HOME/.config/cursor"
AUTH_FILE="$AUTH_DIR/auth.json"

if [[ -z "${CURSOR_API_KEY:-}" ]]; then
  echo "CURSOR_API_KEY is not set; skipping Cursor Agent authentication."
  exit 0
fi

mkdir -p "$AUTH_DIR"

jq -n \
  --arg apiKey "$CURSOR_API_KEY" \
  '{apiKey: $apiKey}' > "$AUTH_FILE"

chmod 600 "$AUTH_FILE"

echo "Cursor Agent authentication configured."
