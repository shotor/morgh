#!/usr/bin/env bash
set -euo pipefail

############################################################
######################## setup #############################
############################################################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FEATURES_DIR="$(dirname "$SCRIPT_DIR")"
WORKSPACE_DIR="$(git rev-parse --show-toplevel)"

FEATURE="$1"
FEATURE_DIR="$FEATURES_DIR/$FEATURE"

############################################################
######################## sources ###########################
############################################################

source "$WORKSPACE_DIR/.scripts/utils/log"
source "$WORKSPACE_DIR/.scripts/utils/bump_package"
source "$WORKSPACE_DIR/.scripts/utils/generate_changelog"
source "$WORKSPACE_DIR/.scripts/utils/get_version"
source "$WORKSPACE_DIR/.scripts/utils/get_package_tag"

############################################################
###################### generate docs #######################
############################################################

info "$FEATURE: generating documentation"

devcontainer features generate-docs \
  -p "$FEATURES_DIR" \
  -n shotor/devcontainer/features \
  >&2

# generate-docs may generate docs for other features too,
# so restore changes outside the current feature.

for feature_dir in "$FEATURES_DIR"/*; do
  [ -d "$feature_dir" ] || continue
  [ "$feature_dir" = "$FEATURE_DIR" ] && continue

  git restore --source=HEAD --staged --worktree -- "$feature_dir"
done

############################################################
######################## version ###########################
############################################################

from_version="$(get_version "$FEATURE_DIR")"

info "$FEATURE: bumping version"

bump_package "$FEATURE_DIR" >&2

new_version="$(get_version "$FEATURE_DIR")"
tag="$(get_package_tag "$FEATURE_DIR" "$new_version")"

success "$FEATURE: $from_version -> $new_version"

############################################################
###################### changelog ###########################
############################################################

info "$FEATURE: generating changelog"

generate_changelog "$FEATURE_DIR" "$tag" >&2

############################################################
######################## build #############################
############################################################

info "$FEATURE: packaging"

devcontainer features package -f \
  "$FEATURE_DIR" \
  -o "$FEATURE_DIR/output" \
  >&2

success "$FEATURE: build complete"

############################################################
######################## return ############################
############################################################

success "$FEATURE: $tag"
echo "$tag"
