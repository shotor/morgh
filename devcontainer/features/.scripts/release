#!/usr/bin/env bash
set -euo pipefail

############################################################
######################## setup #############################
############################################################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FEATURES_DIR="$(dirname "$SCRIPT_DIR")"
WORKSPACE_DIR="$(git rev-parse --show-toplevel)"

CHANGED_FEATURES=()

DRY_RUN=false

############################################################
######################## parse #############################
############################################################

usage() {
  cat <<EOF
Usage: $0 [options]

Release changed Dev Container features.

Options:
  --dry-run       Log what would be published without publishing
  -h, --help      Show this help message
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run)
      DRY_RUN=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo >&2
      usage >&2
      exit 1
      ;;
  esac

  shift
done

############################################################
######################### check ############################
############################################################

source "$WORKSPACE_DIR/.scripts/utils/has_commit_changes"

echo "Devcontainer features" >&2

for feature_dir in "$FEATURES_DIR"/*; do
  [ -d "$feature_dir" ] || continue

  feature="$(basename "$feature_dir")"

  if has_commit_changes "$feature_dir"; then
    echo "  $feature: will release" >&2
    CHANGED_FEATURES+=("$feature")
  else
    echo "  $feature: no changes" >&2
  fi
done

############################################################
######################## release ###########################
############################################################

for feature in "${CHANGED_FEATURES[@]}"; do
  feature_dir="$FEATURES_DIR/$feature"
  output_dir="$feature_dir/output"

  if [ ! -d "$output_dir" ]; then
    echo "$feature: output directory not found" >&2
    exit 1
  fi

  if [ "$DRY_RUN" = true ]; then
    echo "  $feature: would publish $output_dir" >&2
    continue
  fi

  echo "  $feature: publishing" >&2

  devcontainer features publish \
    -r ghcr.io \
    -n shotor \
    "$output_dir" \
    >&2
done
