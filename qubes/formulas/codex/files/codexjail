#!/usr/bin/env bash
set -euo pipefail

if [[ ${1-} == --help ]]; then
  echo 'Usage: codexjail [DIRECTORY] [CODEX_ARGUMENTS...]'
  echo 'Default directory: /srv. Explicit directories may be /srv or under /srv/git or /srv/shotor.'
  exit 0
fi
if [[ $# -eq 0 ]]; then
  set -- /srv
fi

if [[ $EUID == 0 ]]; then
  export PATH=/usr/sbin:/usr/bin:/sbin:/bin
  systemctl start codexjail-network.service
  /usr/libexec/morgh/codexjail-network refresh
  exec ip netns exec codexjail setpriv \
    --reuid=agent --regid=work --init-groups --no-new-privs \
    env -i HOME=/home/agent PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    TERM="${TERM:-xterm-256color}" /usr/bin/codexjail "$@"
elif [[ $(id -un) != agent || $(id -gn) != work ]]; then
  exec sudo -- /usr/bin/codexjail "$@"
fi

current_net=$(stat -Lc %i /proc/self/ns/net) || exit 1
isolated_net=$(stat -Lc %i /run/netns/codexjail) || exit 1
if [[ $current_net != "$isolated_net" ]]; then
  echo 'Codex must run in its isolated network namespace.' >&2
  exit 1
fi

project=$(realpath -e -- "$1")
shift
if [[ ! -d "$project" || ( "$project" != /srv && "$project" != /srv/git && "$project" != /srv/git/* && "$project" != /srv/shotor && "$project" != /srv/shotor/* ) ]]; then
  echo 'Project must be /srv or a directory under /srv/git or /srv/shotor.' >&2
  exit 1
fi

codex_package=$(dirname -- "$(dirname -- "$(readlink -f /usr/bin/codex)")")

umask 0002
mounts=()
workspace_args=(--add-dir /srv/git)
if [[ -d /srv/shotor ]]; then
  mounts+=(--bind /srv/shotor /srv/shotor)
  workspace_args+=(--add-dir /srv/shotor)
fi
for path in /bin /sbin /lib /lib64; do
  if [[ -L "$path" ]]; then
    mounts+=(--symlink "$(readlink -- "$path")" "$path")
  elif [[ -d "$path" ]]; then
    mounts+=(--ro-bind "$path" "$path")
  fi
done
for path in /etc/passwd /etc/group /etc/ssl/certs /etc/alternatives /etc/localtime /etc/terminfo /opt/neovim; do
  if [[ -e "$path" ]]; then
    mounts+=(--ro-bind "$path" "$path")
  fi
done

terminal_args=(--new-session)
if [[ -t 0 && -t 1 ]]; then
  terminal_args=()
fi

sandbox=(bwrap \
  --unshare-all --share-net --die-with-parent "${terminal_args[@]}" \
  --cap-drop ALL --clearenv \
  --ro-bind /usr /usr \
  --ro-bind /opt/codex /opt/codex \
  --ro-bind /etc/codexjail/resolv.conf /etc/resolv.conf \
  --ro-bind /etc/codexjail/nsswitch.conf /etc/nsswitch.conf \
  --ro-bind /etc/codexjail/hosts /etc/hosts \
  "${mounts[@]}" \
  --proc /proc --dev /dev --tmpfs /tmp --dir /run \
  --tmpfs /home --dir /home/agent \
  --bind /var/lib/codex-agent /home/agent/.codex \
  --bind /srv/git /srv/git \
  --setenv HOME /home/agent \
  --setenv USER agent --setenv LOGNAME agent \
  --setenv CODEX_HOME /home/agent/.codex \
  --setenv PATH "$codex_package/codex-path:/usr/bin:/bin" \
  --setenv TERM "${TERM:-xterm-256color}" \
  --setenv LANG C.UTF-8 --setenv LC_ALL C.UTF-8 \
  --setenv GIT_CONFIG_COUNT 2 \
  --setenv GIT_CONFIG_KEY_0 safe.directory \
  --setenv GIT_CONFIG_VALUE_0 "$project" \
  --setenv GIT_CONFIG_KEY_1 core.sharedRepository \
  --setenv GIT_CONFIG_VALUE_1 group \
  --chdir "$project" \
  /usr/bin/codex --no-alt-screen --sandbox workspace-write "${workspace_args[@]}" --ask-for-approval on-request "$@")

if [[ -t 0 && -t 1 ]]; then
  printf -v sandbox_command '%q ' "${sandbox[@]}"
  exec env SHELL=/bin/bash script --quiet --return --command "exec $sandbox_command" /dev/null
fi

exec "${sandbox[@]}"
