#!/usr/bin/python3
import json
from pathlib import Path
import sys
import time


CONFIG = Path('/etc/morgh/idle-netvms.json')
STATE = Path('/run/morgh-idle-netvms/candidates.json')
GRACE_SECONDS = 300


def sweep(app, gateways, previous, now):
    machines = {vm.name: vm for vm in app.domains if vm.name != 'dom0'}
    states = {name: vm.get_power_state() for name, vm in machines.items()}
    used = set()
    for name, vm in machines.items():
        if states[name] != 'Halted':
            upstream = getattr(vm, 'netvm', None)
            if upstream is not None:
                used.add(upstream.name)

    candidates = {}
    for name in gateways:
        vm = machines.get(name)
        if vm is None or states[name] != 'Running' or name in used:
            continue
        if not vm.provides_network:
            continue
        xid = vm.xid
        old = previous.get(name, {})
        since = old.get('since', now) if old.get('xid') == xid else now
        if now - since < GRACE_SECONDS:
            candidates[name] = {'xid': xid, 'since': since}
            continue
        try:
            vm.shutdown(force=False)
            print(f'Shutdown requested for unused gateway {name}', flush=True)
        except Exception as error:
            print(f'Kept {name} running: {error}', file=sys.stderr)
    return candidates


def main():
    import qubesadmin

    try:
        gateways = json.loads(CONFIG.read_text())
        previous = json.loads(STATE.read_text()) if STATE.exists() else {}
        candidates = sweep(qubesadmin.Qubes(), gateways, previous, time.monotonic())
        temporary = STATE.with_suffix('.tmp')
        temporary.write_text(json.dumps(candidates))
        temporary.replace(STATE)
    except Exception as error:
        STATE.unlink(missing_ok=True)
        print(f'Gateway check failed; idle countdowns reset: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
