#!/bin/sh
set -eu
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
terminal_config=$(readlink -f -- "$config_home/urxvt/config" || true)
theme=${terminal_config##*/}
theme=${theme%.Xresources}
case "$theme" in
    shotormorgh-*) ;;
    *) theme=shotormorgh-dark ;;
esac
theme_file="$config_home/rofi/themes/$theme.rasi"
if [ ! -f "$theme_file" ]; then
    theme_file="$config_home/rofi/themes/shotormorgh-dark.rasi"
fi
exec rofi -theme "$theme_file" "$@"
