set -g status-style 'bg={{dark.surface}},fg={{dark.fg}}'
set -g message-style 'bg={{dark.selection}},fg={{dark.fg}}'
set -g message-command-style 'bg={{dark.selection}},fg={{dark.fg}}'
set -g pane-border-style 'fg={{dark.surface}}'
set -g pane-active-border-style 'fg={{dark.accent}}'
set -g mode-style 'bg={{dark.selection}},fg={{dark.fg}}'
set -g status-left-style 'bg={{dark.header}},fg={{dark.header_fg}},bold'
set -g status-right-style 'fg={{dark.muted}}'
setw -g window-status-style 'fg={{dark.muted}},bg={{dark.surface}}'
setw -g window-status-current-style 'fg={{dark.accent}},bg={{dark.selection}},bold'
setw -g window-status-activity-style 'fg={{dark.yellow}},bold'
setw -g window-status-bell-style 'fg={{dark.red}},bold'
