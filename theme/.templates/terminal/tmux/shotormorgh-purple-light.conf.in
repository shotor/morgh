set -g @shotormorgh_header '{{purple_light.header}}'
set -g @shotormorgh_header_fg '{{purple_light.header_fg}}'
set -g @shotormorgh_accent '{{purple_light.accent}}'
set -g @shotormorgh_bg '{{purple_light.bg}}'
set -g @shotormorgh_yellow '{{purple_light.yellow}}'
set -g @shotormorgh_red '{{purple_light.red}}'

set -g status-style 'bg={{purple_light.surface}},fg={{purple_light.fg}}'
set -g message-style 'bg={{purple_light.selection}},fg={{purple_light.fg}}'
set -g message-command-style 'bg={{purple_light.selection}},fg={{purple_light.fg}}'
set -g pane-border-style 'fg={{purple_light.surface}}'
set -g pane-active-border-style 'fg={{purple_light.accent}}'
set -g mode-style 'bg={{purple_light.selection}},fg={{purple_light.fg}}'
set -g status-left-style 'bg={{purple_light.header}},fg={{purple_light.header_fg}},bold'
set -g status-right-style 'fg={{purple_light.muted}}'
setw -g window-status-style 'fg={{purple_light.muted}},bg={{purple_light.surface}}'
setw -g window-status-current-style 'fg={{purple_light.accent}},bg={{purple_light.selection}},bold'
setw -g window-status-activity-style 'fg={{purple_light.yellow}},bold'
setw -g window-status-bell-style 'fg={{purple_light.red}},bold'
