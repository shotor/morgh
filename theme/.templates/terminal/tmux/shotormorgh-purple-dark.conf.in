set -g @shotormorgh_header '{{purple_dark.header}}'
set -g @shotormorgh_header_fg '{{purple_dark.header_fg}}'
set -g @shotormorgh_accent '{{purple_dark.accent}}'
set -g @shotormorgh_bg '{{purple_dark.bg}}'
set -g @shotormorgh_yellow '{{purple_dark.yellow}}'
set -g @shotormorgh_red '{{purple_dark.red}}'

set -g status-style 'bg={{purple_dark.surface}},fg={{purple_dark.fg}}'
set -g message-style 'bg={{purple_dark.selection}},fg={{purple_dark.fg}}'
set -g message-command-style 'bg={{purple_dark.selection}},fg={{purple_dark.fg}}'
set -g pane-border-style 'fg={{purple_dark.surface}}'
set -g pane-active-border-style 'fg={{purple_dark.accent}}'
set -g mode-style 'bg={{purple_dark.selection}},fg={{purple_dark.fg}}'
set -g status-left-style 'bg={{purple_dark.header}},fg={{purple_dark.header_fg}},bold'
set -g status-right-style 'fg={{purple_dark.muted}}'
setw -g window-status-style 'fg={{purple_dark.muted}},bg={{purple_dark.surface}}'
setw -g window-status-current-style 'fg={{purple_dark.accent}},bg={{purple_dark.selection}},bold'
setw -g window-status-activity-style 'fg={{purple_dark.yellow}},bold'
setw -g window-status-bell-style 'fg={{purple_dark.red}},bold'
