set -g status-style 'bg={{light.surface}},fg={{light.fg}}'
set -g message-style 'bg={{light.selection}},fg={{light.fg}}'
set -g message-command-style 'bg={{light.selection}},fg={{light.fg}}'
set -g pane-border-style 'fg={{light.surface}}'
set -g pane-active-border-style 'fg={{light.accent}}'
set -g mode-style 'bg={{light.selection}},fg={{light.fg}}'
set -g status-left-style 'bg={{light.header}},fg={{light.header_fg}},bold'
set -g status-right-style 'fg={{light.muted}}'
setw -g window-status-style 'fg={{light.muted}},bg={{light.surface}}'
setw -g window-status-current-style 'fg={{light.accent}},bg={{light.selection}},bold'
setw -g window-status-activity-style 'fg={{light.yellow}},bold'
setw -g window-status-bell-style 'fg={{light.red}},bold'
