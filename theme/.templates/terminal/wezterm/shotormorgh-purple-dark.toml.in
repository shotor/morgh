[metadata]
name = "shotormorgh-purple-dark"
author = "shotor"

[colors]
foreground = "{{purple_dark.fg}}"
background = "{{purple_dark.bg}}"
cursor_bg = "{{purple_dark.accent}}"
cursor_fg = "{{purple_dark.bg}}"
cursor_border = "{{purple_dark.accent}}"
selection_fg = "{{purple_dark.fg}}"
selection_bg = "{{purple_dark.selection}}"
ansi = ["{{purple_dark.ansi.0}}","{{purple_dark.ansi.1}}","{{purple_dark.ansi.2}}","{{purple_dark.ansi.3}}","{{purple_dark.ansi.4}}","{{purple_dark.ansi.5}}","{{purple_dark.ansi.6}}","{{purple_dark.ansi.7}}"]
brights = ["{{purple_dark.brights.0}}","{{purple_dark.brights.1}}","{{purple_dark.brights.2}}","{{purple_dark.brights.3}}","{{purple_dark.brights.4}}","{{purple_dark.brights.5}}","{{purple_dark.brights.6}}","{{purple_dark.brights.7}}"]

[colors.tab_bar]
background = "{{purple_dark.surface}}"

[colors.tab_bar.active_tab]
bg_color = "{{purple_dark.header}}"
fg_color = "{{purple_dark.header_fg}}"
intensity = "Bold"

[colors.tab_bar.inactive_tab]
bg_color = "{{purple_dark.surface}}"
fg_color = "{{purple_dark.muted}}"

[colors.tab_bar.new_tab]
bg_color = "{{purple_dark.surface}}"
fg_color = "{{purple_dark.accent}}"
