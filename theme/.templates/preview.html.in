          --fg:{{dark.fg}};
          --surface:{{dark.surface}};
          --selection:{{dark.selection}};
          --muted:{{dark.muted}};
          --accent:{{dark.accent}};
          --header:{{dark.header}};
          --red:{{dark.red}};
