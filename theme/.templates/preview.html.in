              </div>
              <div class="swatch">
                <div class="chip" style="background:{{light.ansi.4}}" title="blue {{light.ansi.4}}">
                </div>
                <span style="color:{{light.ansi.4}}">
                  blue
                </span>
                <div class="hex">
                  {{light.ansi.4}}
                </div>
              </div>
              <div class="swatch">
                <div class="chip" style="background:{{light.ansi.5}}" title="magenta {{light.ansi.5}}">
                </div>
                <span style="color:{{light.ansi.5}}">
                  magenta
                </span>
                <div class="hex">
                  {{light.ansi.5}}
                </div>
              </div>
              <div class="swatch">
                <div class="chip" style="background:{{light.ansi.6}}" title="cyan {{light.ansi.6}}">
                </div>
                <span style="color:{{light.ansi.6}}">
                  cyan
                </span>
                <div class="hex">
                  {{light.ansi.6}}
                </div>
              </div>
              <div class="swatch">
                <div class="chip" style="background:{{light.ansi.7}}" title="white {{light.ansi.7}}">
                </div>
                <span style="color:{{light.ansi.7}}">
                  white
                </span>
                <div class="hex">
                  {{light.ansi.7}}
                </div>
              </div>
              <div class="swatch">
                <div class="chip" style="background:{{light.brights.0}}" title="black {{light.brights.0}}">
                </div>
                <span style="color:{{light.brights.0}}">
                  black
                </span>
                <div class="hex">
                  {{light.brights.0}}
                </div>
              </div>
              <div class="swatch">
                <div class="chip" style="background:{{light.brights.1}}" title="red {{light.brights.1}}">
                </div>
                <span style="color:{{light.brights.1}}">
                  red
                </span>
                <div class="hex">
                  {{light.brights.1}}
                </div>
              </div>
              <div class="swatch">
                <div class="chip" style="background:{{light.brights.2}}" title="green {{light.brights.2}}">
                </div>
                <span style="color:{{light.brights.2}}">
                  green
                </span>
                <div class="hex">
                  {{light.brights.2}}
                </div>
              </div>
              <div class="swatch">
                <div class="chip" style="background:{{light.brights.3}}" title="yellow {{light.brights.3}}">
                </div>
                <span style="color:{{light.brights.3}}">
                  yellow
                </span>
                <div class="hex">
                  {{light.brights.3}}
                </div>
              </div>
              <div class="swatch">
                <div class="chip" style="background:{{light.brights.4}}" title="blue {{light.brights.4}}">
                </div>
                <span style="color:{{light.brights.4}}">
                  blue
                </span>
                <div class="hex">
                  {{light.brights.4}}
                </div>
              </div>
              <div class="swatch">
                <div class="chip" style="background:{{light.brights.5}}" title="magenta {{light.brights.5}}">
                </div>
                <span style="color:{{light.brights.5}}">
                  magenta
                </span>
                <div class="hex">
                  {{light.brights.5}}
                </div>
              </div>
              <div class="swatch">
                <div class="chip" style="background:{{light.brights.6}}" title="cyan {{light.brights.6}}">
                </div>
                <span style="color:{{light.brights.6}}">
                  cyan
                </span>
                <div class="hex">
                  {{light.brights.6}}
                </div>
              </div>
              <div class="swatch">
                <div class="chip" style="background:{{light.brights.7}}" title="white {{light.brights.7}}">
                </div>
                <span style="color:{{light.brights.7}}">
                  white
                </span>
                <div class="hex">
                  {{light.brights.7}}
                </div>
              </div>
            </div>
            <div class="contrast">
              Foreground {{light.contrast_fg}}:1 · comments {{light.contrast_muted}}:1 · lowest semantic ANSI {{light.contrast_ansi}}:1
            </div>
            {{light.color_details}}
          </section>

        </article>

        <article class="card dark" style="
