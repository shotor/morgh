    "diffEditor.removedTextBackground": "#ef9a8625"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#ac9dc0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#b7c892"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#d1b4f5"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#d2a9c4"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#d1b4f5"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#9ebed5"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#ecc985"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#f8f4fe"
      }
    },
    {
      "name": "Builtins",
      "scope": [
        "variable.language",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#96c5bd"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#ac9dc0"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#d1b4f5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#9ebed5",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#b7c892"
      }
    },
    {
      "name": "Removed",
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#ef9a86"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#f8f4fe",
    "parameter": "#f8f4fe",
    "property": "#f8f4fe",
    "function": "#9ebed5",
    "method": "#9ebed5",
    "type": "#ecc985",
    "class": "#ecc985",
    "interface": "#ecc985",
    "enum": "#ecc985",
    "enumMember": "#d1b4f5",
    "variable.readonly": "#d1b4f5",
    "namespace": "#96c5bd",
    "keyword": "#d2a9c4",
    "string": "#b7c892",
    "number": "#d1b4f5",
    "operator": "#d1b4f5"
  }
}
