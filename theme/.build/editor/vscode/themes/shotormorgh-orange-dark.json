    "terminal.ansiBrightCyan": "#72c9c3",
    "terminal.ansiWhite": "#f8ece1",
    "terminal.ansiBrightWhite": "#f8ece1",
    "diffEditor.insertedTextBackground": "#95c69625",
    "diffEditor.removedTextBackground": "#e9a29c25"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#baa38e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#95c696"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#eab582"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#d4a5d6"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#eab582"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#93baed"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#c8b778"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#f8ece1"
      }
    },
    {
      "name": "Builtins",
      "scope": [
        "variable.language",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#72c9c3"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#baa38e"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#eab582",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#93baed",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#95c696"
      }
    },
    {
      "name": "Removed",
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#e9a29c"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#f8ece1",
    "parameter": "#f8ece1",
    "property": "#f8ece1",
    "function": "#93baed",
    "method": "#93baed",
    "type": "#c8b778",
    "class": "#c8b778",
    "interface": "#c8b778",
    "enum": "#c8b778",
    "enumMember": "#eab582",
    "variable.readonly": "#eab582",
    "namespace": "#72c9c3",
    "keyword": "#d4a5d6",
    "string": "#95c696",
    "number": "#eab582",
    "operator": "#eab582"
  }
}
