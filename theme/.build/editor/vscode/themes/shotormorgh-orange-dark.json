    "quickInput.foreground": "#f8ece1",
    "terminal.background": "#2c1b09",
    "terminal.foreground": "#f8ece1",
    "terminalCursor.foreground": "#eab582",
    "terminal.selectionBackground": "#5a3b1a",
    "gitDecoration.addedResourceForeground": "#95c696",
    "gitDecoration.deletedResourceForeground": "#e9a29c",
    "gitDecoration.modifiedResourceForeground": "#c8b778",
    "gitDecoration.untrackedResourceForeground": "#72c9c3",
