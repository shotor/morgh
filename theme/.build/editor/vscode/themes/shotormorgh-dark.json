    "terminal.ansiBrightWhite": "#fdf4ec",
    "diffEditor.insertedTextBackground": "#b7c89225",
    "diffEditor.removedTextBackground": "#ef9a8625"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#bd9e82",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#b7c892"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#f0b48a"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#d2a9c4"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#f0b48a"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#9ebed5"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#ecc985"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#fdf4ec"
      }
    },
    {
      "name": "Builtins",
      "scope": [
        "variable.language",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#96c5bd"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#bd9e82"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#f0b48a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#9ebed5",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#b7c892"
      }
    },
    {
      "name": "Removed",
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#ef9a86"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#fdf4ec",
    "parameter": "#fdf4ec",
    "property": "#fdf4ec",
    "function": "#9ebed5",
    "method": "#9ebed5",
    "type": "#ecc985",
    "class": "#ecc985",
    "interface": "#ecc985",
    "enum": "#ecc985",
    "enumMember": "#f0b48a",
    "variable.readonly": "#f0b48a",
    "namespace": "#96c5bd",
    "keyword": "#d2a9c4",
    "string": "#b7c892",
    "number": "#f0b48a",
    "operator": "#f0b48a"
  }
}
