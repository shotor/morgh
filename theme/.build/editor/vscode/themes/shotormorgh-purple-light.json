    "notifications.background": "#ede5f8",
    "notifications.foreground": "#2d2239",
    "quickInput.background": "#ede5f8",
    "quickInput.foreground": "#2d2239",
    "terminal.background": "#faf7ff",
    "terminal.foreground": "#2d2239",
    "terminalCursor.foreground": "#8155ae",
    "terminal.selectionBackground": "#ddd0ef",
    "gitDecoration.addedResourceForeground": "#44643c",
    "gitDecoration.deletedResourceForeground": "#a43d32",
    "gitDecoration.modifiedResourceForeground": "#876000",
    "gitDecoration.untrackedResourceForeground": "#286967",
    "terminal.ansiBlack": "#2d2239",
    "terminal.ansiBrightBlack": "#706381",
    "terminal.ansiRed": "#a43d32",
    "terminal.ansiBrightRed": "#b34536",
    "terminal.ansiGreen": "#44643c",
    "terminal.ansiBrightGreen": "#4c703f",
    "terminal.ansiYellow": "#876000",
    "terminal.ansiBrightYellow": "#8155ae",
    "terminal.ansiBlue": "#365f83",
    "terminal.ansiBrightBlue": "#3b6b94",
    "terminal.ansiMagenta": "#80516f",
    "terminal.ansiBrightMagenta": "#92577e",
    "terminal.ansiCyan": "#286967",
    "terminal.ansiBrightCyan": "#287976",
    "terminal.ansiWhite": "#ddd0ef",
    "terminal.ansiBrightWhite": "#faf7ff",
    "diffEditor.insertedTextBackground": "#44643c25",
    "diffEditor.removedTextBackground": "#a43d3225"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#706381",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#44643c"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#8155ae"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#80516f"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#8155ae"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#365f83"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#876000"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#2d2239"
      }
    },
    {
      "name": "Builtins",
      "scope": [
        "variable.language",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#286967"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#706381"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#8155ae",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#365f83",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#44643c"
      }
    },
    {
      "name": "Removed",
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#a43d32"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#2d2239",
    "parameter": "#2d2239",
    "property": "#2d2239",
    "function": "#365f83",
    "method": "#365f83",
    "type": "#876000",
    "class": "#876000",
    "interface": "#876000",
    "enum": "#876000",
    "enumMember": "#8155ae",
    "variable.readonly": "#8155ae",
    "namespace": "#286967",
    "keyword": "#80516f",
    "string": "#44643c",
    "number": "#8155ae",
    "operator": "#8155ae"
  }
}
