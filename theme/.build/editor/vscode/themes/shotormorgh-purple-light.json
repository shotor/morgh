    "terminal.ansiBrightWhite": "#faf7fd",
    "diffEditor.insertedTextBackground": "#3a673c25",
    "diffEditor.removedTextBackground": "#84464225"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#66606f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#3a673c"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#6f4797"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#734975"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#6f4797"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#385c8a"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#6a5a18"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#292330"
      }
    },
    {
      "name": "Builtins",
      "scope": [
        "variable.language",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#006965"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#66606f"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#6f4797",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#385c8a",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#3a673c"
      }
    },
    {
      "name": "Removed",
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#844642"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#292330",
    "parameter": "#292330",
    "property": "#292330",
    "function": "#385c8a",
    "method": "#385c8a",
    "type": "#6a5a18",
    "class": "#6a5a18",
    "interface": "#6a5a18",
    "enum": "#6a5a18",
    "enumMember": "#6f4797",
    "variable.readonly": "#6f4797",
    "namespace": "#006965",
    "keyword": "#734975",
    "string": "#3a673c",
    "number": "#6f4797",
    "operator": "#6f4797"
  }
}
